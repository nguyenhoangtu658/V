
local function killMessage(obj)
    if obj:IsA("Frame") or obj:IsA("TextLabel") then
        if obj:FindFirstChild("Text") or obj:IsA("TextLabel") then
            local txt = obj.Text or ""

            if string.find(txt, TARGET) then
                local parent = obj.Parent
                if parent then
                    parent:Destroy()
                else
                    obj:Destroy()
                end
            end
        end
    end
end

game.DescendantAdded:Connect(function(obj)
    pcall(killMessage, obj)
end)

workspace.DescendantAdded:Connect(function(obj)
    if obj:IsA("BillboardGui") then
        local txt = obj:FindFirstChildWhichIsA("TextLabel")
        if txt and txt.Text and string.find(txt.Text, TARGET) then
            obj:Destroy()
        end
    end
end)

for _, v in ipairs(game:GetDescendants()) do
    pcall(killMessage, v)
end
