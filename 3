local Workspace = game:GetService("Workspace")

local center = Vector3.new(-5019.19, 10391.98, -4617.25)
local size = Vector3.new(54.00, 27.00, 20.24)

local minBound = center - size/2
local maxBound = center + size/2

local region = Region3.new(minBound, maxBound)
region = region:ExpandToGrid(4)

local function isProtected(obj)
    return obj.Name == "Center"
        or obj.Name == "floor"
        or obj:FindFirstAncestor("Center")
        or obj:FindFirstAncestor("floor")
end

local partsInRegion = Workspace:FindPartsInRegion3(region, nil, math.huge)

for _, part in pairs(partsInRegion) do
    if not isProtected(part) then
        part:Destroy()
    end
end

for _, obj in pairs(Workspace:GetDescendants()) do
    if obj:IsA("Model") and not isProtected(obj) then
        local shouldDestroy = false

        for _, p in pairs(obj:GetDescendants()) do
            if p:IsA("BasePart") and not isProtected(p) then
                local minObj = p.Position - p.Size/2
                local maxObj = p.Position + p.Size/2

                local overlap = (minObj.X <= maxBound.X and maxObj.X >= minBound.X)
                             and (minObj.Y <= maxBound.Y and maxObj.Y >= minBound.Y)
                             and (minObj.Z <= maxBound.Z and maxObj.Z >= minBound.Z)

                if overlap then
                    shouldDestroy = true
                    break
                end
            end
        end

        if shouldDestroy then
            obj:Destroy()
        end
    end
end

local targets = {
    CFrame.new(-5003.46436, 10382.3359, -4629.50488, 1, -0.000517932116, 0, 0.000517932116, 0.999999881, 0, 0, 0, 1.00000024),
    CFrame.new(-5003.46533, 10383.8838, -4629.50488, 1, -0.000517932116, 0, 0.000517932116, 0.999999881, 0, 0, 0, 1.00000024),
    CFrame.new(-5003.2002, 10396.8184, -4628.9209, 0.820813179, -0.000463497825, 0.571196675, 0.000360145641, 0.999999881, 0.000293918885, -0.571196795, -3.55384691e-05, 0.820813298),
    CFrame.new(-5031.79639, 10396.7998, -4628.91113, 0.820813179, -0.000463497825, -0.571196675, 0.000360145641, 0.999999881, -0.000293918885, 0.571196795, 3.55384691e-05, 0.820813298)
}

local function isExactCFrame(cf1, cf2)
    local a = {cf1:GetComponents()}
    local b = {cf2:GetComponents()}

    for i = 1, #a do
        if a[i] ~= b[i] then
            return false
        end
    end
    return true
end

for _, obj in pairs(Workspace:GetDescendants()) do
    if obj:IsA("BasePart") and obj.Name == "Part" then
        for _, target in pairs(targets) do
            if isExactCFrame(obj.CFrame, target) then
                obj:Destroy()
                break
            end
        end
    end
end
